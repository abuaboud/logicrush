{
  "name": "@logicrush/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "node --watch --env-file-if-exists=../../../.env --import tsx src/app.ts",
    "start": "node dist/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=../../../.env --import tsx src/infra/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.0.0",
    "@logicrush/shared": "*",
    "argon2": "^0.44.0",
    "env-var": "^7.5.0",
    "fastify": "^5.2.0",
    "fastify-type-provider-zod": "^6.1.0",
    "kysely": "^0.28.12",
    "nanoid": "^5.0.0",
    "pg": "^8.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
